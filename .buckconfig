[cells]
  effect_utils = .
  capabilities = .buck2/capabilities
  prelude = prelude

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbsource = prelude
  toolchains = effect_utils
  rules = effect_utils

[external_cells]
  prelude = bundled

[parser]
  target_platform_detector_spec = target:effect_utils//...->effect_utils//buck2/platforms:host_platform

[build]
  execution_platforms = effect_utils//buck2/platforms:host_execution_platform

[buck2]
  file_watcher = notify
  allow_cache_uploads = false
  digest_algorithms = SHA256

# Public cache tier (decision 0033): anonymous TLS reads. The posture script
# adds the protected publisher's writer overlay to `.buckconfig.local`.
[buck2_re_client]
  action_cache_address = grpc://dev3.tail8108.ts.net:8443
  cas_address = grpc://dev3.tail8108.ts.net:8443
  engine_address = grpc://dev3.tail8108.ts.net:8443
  instance_name = effect-utils
  tls = true

[archive_origin]
  # Source of truth for trusted local and protected-main seeding. The
  # reconciler projects these into gitignored `url_prefix`/`tier` keys.
  # Public/cache-cold contexts project an empty URL and use the registry.
  trusted_url_prefix = http://dev3:41046/cas/
  trusted_tier = private

[project]
  ignore = **/__pycache__,**/dist,**/node_modules,**/node_modules/**,**/target,**/target/**,.buck2/capabilities.candidate.*,.devenv,.git,buck-out,node_modules,packages/.editor-view,target,tmp
