@@ -2098,6 +2106,7 @@ def _rustc_invoke(
         no_outputs_cleanup = incremental_enabled,
         allow_cache_upload = action_allow_cache_upload,
         error_handler = toolchain_info.rust_error_handler,
+        **adapter_options
     )
 
     return Invoke(
