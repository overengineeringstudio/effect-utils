 load(
     ":sources.bzl",
     "RustSources",
@@ -2088,6 +2089,13 @@ def _rustc_invoke(
         # Libraries (check, metadata, rlib) have no preference.
         action_allow_cache_upload = None
 
+    compile_cmd, adapter_options = adapt_rustc_action(
