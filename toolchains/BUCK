    name = "pnpm_materializer",
    bun_by_platform = _BUN_BY_PLATFORM,
    pnpm_by_platform = {
        "aarch64-darwin": "/nix/store/k46nss1qlk8j68kngw208vkwhg9cqcn9-pnpm-11.8.0/bin/pnpm",
        "aarch64-linux": "/nix/store/vg4amiiw9cjni2dpaaalvv6w74ljsb1h-pnpm-11.8.0/bin/pnpm",
        "x86_64-linux": "/nix/store/djqhycbimp9m29kkih601r9byjipr53l-pnpm-11.8.0/bin/pnpm",
    },
    store_dir = "repos/effect-utils/.devenv/pnpm-store-pure-v1",
    visibility = ["PUBLIC"],
)

# TypeScript vertical-slice toolchain. Bun and effect-tsgo are exact executable
# paths from this repository's pinned Nix inputs. The selected pair is immutable
# and identical across worktrees on the same host platform, so both commands are
# represented in the action-key identity (EXEC-R02).
effect_tsgo_toolchain(
    name = "effect_tsgo",
    bun_by_platform = _BUN_BY_PLATFORM,
    executable_by_platform = _TSGO_BY_PLATFORM,
    runner = "effect_utils//:packages/@overeng/buck2-tools/src/typescript-runner.ts",
    visibility = ["PUBLIC"],
)

