# Nix activation provides the logical commands; each tool attests its semantic
# capability identity before performing work.
support_tool(
    name = "closure_tool",
    protocol = "effect-utils/buck2-closure-tool/v1",
    tool_id = "closure-tool",
    visibility = ["PUBLIC"],
)

# Prelude Rust compilation and linking consume both conventional providers,
# but only Rust product invocations supply that independently rooted config.
# The macro is a no-op without it, so stage-0 and TypeScript-only graphs do not
# accidentally acquire a Rust/Nix dependency merely by loading this package.
nix_local_rust_cxx_python_toolchains()

conventional_toolchain_probe(
    name = "conventional_rust_cxx_execution_probe",
    toolchain_identity = read_config("rust_toolchain", "compile_identity", ""),
    visibility = ["PUBLIC"],
)

