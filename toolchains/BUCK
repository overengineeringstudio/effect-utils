    name = "effect_tsgo",
    executable_by_platform = {
        "aarch64-darwin": "/nix/store/ail3pcz77kk0l1zbagrx21afafshbdjy-effect-tsgo/bin/tsgo",
        "aarch64-linux": "/nix/store/ff6w5r5rhnfx31cb1b3ff0h21x058150-effect-tsgo/bin/tsgo",
        "x86_64-linux": "/nix/store/m59qqc61pdii7xfjnpfzjas5fx0z2ggx-effect-tsgo/bin/tsgo",
