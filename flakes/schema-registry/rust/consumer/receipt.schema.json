    },
    "host": {
      "type": "string"
    },
    "class": {
      "type": "string"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "cwd": {
      "type": "string"
    },
    "cmd": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "startedAt": {
      "type": "string"
    },
    "endedAt": {
      "type": "string"
    },
    "exit": {
      "type": "integer",
      "minimum": 0
    },
    "headStart": {
      "type": "string"
    },
    "headEnd": {
      "type": "string"
    },
    "treeStart": {
      "type": "string"
    },
    "cleanStart": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "cleanEnd": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "exact": {
      "type": "boolean"
    },
    "expectShort": {
      "type": "boolean"
    },
