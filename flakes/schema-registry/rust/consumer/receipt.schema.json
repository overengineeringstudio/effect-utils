  "required": [
    "schema",
    "host",
    "class",
    "pid",
    "cwd",
    "cmd",
    "startedAt",
    "endedAt",
    "exit",
    "headStart",
    "headEnd",
    "treeStart",
    "cleanStart",
    "cleanEnd",
    "exact",
    "expectShort",
    "outcome",
