ps4rpjv1imfwqpak31-nodejs-22.20.0', '/nix/store/dynxzxisjy2hwda4hixvwn9lsz953hkw-effect-tsgo', '/nix/store/dyxcy223n2jch1kdf35wxcc39qmz8if5-elfutils-0.195', '/nix/store/f0cf1q1xq068vm85rlksvb8b2fvrznx3-go-official-1.26.5', '/nix/store/fcnnn4w7sxx96liivqdsm1alwyh9x00d-numactl-2.0.18', '/nix/store/g2s1d72zyb62qkp00y6gw1asjbh3wc1l-bun-compile-runtime-1.4.2', '/nix/store/gh8pn111jqdfa94vzivvmikfar1163zw-c++', '/nix/store/jqmy95zj65i032w5nhz8hkr2q8kw5l37-weaver-0.26.1', '/nix/store/jxd26cx6cgbjzal3mzw0vcv8pqdbh0bb-gmp-with-cxx-6.3.0', '/nix/store/kj9h713jm4m0jx3f0jkc3cqwr705nlsd-bash', '/nix/store/lhjawywsl94mklkaqfkszfc5izy001zc-dwp', '/nix/store/lwr2adl967maf9isaf89v5ll8djzb74c-buck2-archive-tool-0.0.0', '/nix/store/lwxahzb47f551sgw4l32084ix7wxfh12-objdump', '/nix/store/v0i9m8xyjn61y4ccw2w53njs92zvnlv1-semconv-model-1.44.0', '/nix/store/n3xi92gj7xc5siwmfnjqxir0d9j63n75-buck2-semconv-model-capability', '/nix/store/nsj69kqd45ij8fblnhspwwhhp3sk5cwf-nixfmt-1.5.0', '/nix/store/q4gzw8bplbi6x01jpfnr6yjzzlkvcz0x-readlink', '/nix/store/q9h2r8cvvsrmhhz41hd6xwgpywbkq6dg-buck2-product-0.0.0', '/nix/store/w20n3pmhhd1av9llykxa3gd21c9jsm8l-cargo-1.98.1', '/nix/store/wsax1sdh8i6fkw8j570wvw47i8ilsdlw-nm', '/nix/store/y8l1qijhci2q5yjlykxd89g0l10awjv7-cargo', '/nix/store/ykfc71yvf7khdgdi7d5cl3fmknaq3j8k-ar', '/nix/store/z08blgya5sci1n3zfrsylz3y0shcgpsy-oxfmt-0.61.0']

# Realizes the effect-utils buck2 capability closure (3.35 GiB, cache.nixos.org +
# overeng-effect-utils Cachix) once per worker at boot.
NIX_STARTUP_CAPS = """
set -eux
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq curl ca-certificates xz-utils >/dev/null
curl -sSfL https://install.determinate.systems/nix | sh -s -- install linux --init none --no-confirm \\
  --extra-conf 'extra-substituters = https://overeng-effect-utils.cachix.org' \\
  --extra-conf 'extra-trusted-public-keys = overeng-effect-utils.cachix.org-1:KFmqYNF6Q7ZzVYPl2znpJYZGEolage9YNCA9res6vKc='
. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
nix-store --realise %s >/dev/null
""" % " ".join(CAPS_PATHS)

POOLS = {
    "default": {"OSFamily": "linux"},
    "nix": {
        "OSFamily": "linux",
        "namespace_pool": "nix-probe-hello-v1",
        "namespace_pool_machine_type": "linux/amd64:4x8",
        "namespace_pool_startup_script": NIX_STARTUP,
        "namespace_action_isolation": "none",
    },
    "macos": {"OSFamily": "macos", "Arch": "arm64"},
    "caps": {
        "OSFamily": "linux",
        "namespace_pool": "effect-utils-caps-" + CAPS,
        "namespace_pool_machine_type": "linux/amd64:8x16",
        "namespace_pool_startup_script": NIX_STARTUP_CAPS,
        "namespace_action_isolation": "none",
    },
    "macos_nix": {
        "OSFamily": "macos",
        "Arch": "arm64",
        "namespace_pool": "nix-probe-hello-darwin-v1",
        "namespace_pool_machine_type": "macos/arm64:6x14",
        "namespace_pool_startup_script": NIX_STARTUP_DARWIN,
        "namespace_action_isolation": "none",
    },
}

_pool = read_config("probe", "pool", "default")
_hello = HELLO_DARWIN if _pool.startswith("macos") else HELLO

execution_platforms(name = "platforms", pools = {_pool: POOLS[_pool]})

# Records the worker environment: OS, arch, tools on PATH, whether /nix exists.
probe(
    name = "env",
    argv = ["/bin/sh", "-c", "out=$0; { echo SALT=$SALT; uname -a; cat /etc/os-release; id; echo PWD=$(pwd); echo PATH=$PATH; nproc; ls -la / ; ls /nix 2>&1; command -v bash sh env python3 node git curl nix 2>&1; } > $out 2>&1"],
    env = {"SALT": "2"},
)

# Uploads an input via CAS and hashes it remotely.
probe(
    name = "hash",
    argv = ["/bin/sh", "-c", "sha256sum $1 > $0"],
    srcs = ["input.txt"],
)

# Execs an absolute /nix/store path that is not transported through the CAS.
probe(
    name = "nix_hello",
    argv = ["/bin/sh", "-c", "{ " + _hello + "/bin/hello; ls -d /nix/store/*-hello-* ; } > $0 2>&1"],
)

# Runs real effect-utils toolchain binaries from the capability closure.
probe(
    name = "caps_tools",
    argv = ["/bin/sh", "-c", "{ /nix/store/dynxzxisjy2hwda4hixvwn9lsz953hkw-effect-tsgo/bin/tsgo --version; /nix/store/g2s1d72zyb62qkp00y6gw1asjbh3wc1l-bun-compile-runtime-1.4.2/bin/bun --version; /nix/store/8wfzh51jrrq6dx9yw2m27ad0hh01lkrx-rustc/bin/rustc --version; /nix/store/7lc821fgljaab8d0wd348dhvz6znlrgr-node/bin/node --version; } > $0 2>&1"],
)
