--- a/buck2/platforms/defs.bzl
+++ b/buck2/platforms/defs.bzl
@@ -136,6 +136,47 @@ def root_remote_cache_enabled():
 def root_allow_cache_uploads():
     return read_root_config("buck2", "allow_cache_uploads", "true") == "true"
 
+
+def namespace_re_enabled():
+    return read_root_config("namespace_re", "enabled", "false") == "true"
+
+def namespace_re_properties():
+    if not namespace_re_enabled():
+        return {}
+    closure_paths = read_root_config("namespace_re", "closure_paths", "")
+    if not closure_paths:
+        fail("namespace_re.closure_paths must name the realized buck2-capabilities tool closure")
+    startup = """
+set -eux
+export DEBIAN_FRONTEND=noninteractive
+apt-get update -qq
+apt-get install -y -qq curl ca-certificates xz-utils >/dev/null
+curl -sSfL https://install.determinate.systems/nix | sh -s -- install linux --init none --no-confirm \
+  --extra-conf 'extra-substituters = https://overeng-effect-utils.cachix.org' \
+  --extra-conf 'extra-trusted-public-keys = overeng-effect-utils.cachix.org-1:KFmqYNF6Q7ZzVYPl2znpJYZGEolage9YNCA9res6vKc='
+. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
+nix-store --realise %s >/dev/null
+""" % closure_paths
+    return {
+        "OSFamily": "linux",
+        "namespace_pool": read_root_config("namespace_re", "pool", "effect-utils-real-graph"),
+        "namespace_pool_machine_type": "linux/amd64:8x16",
+        "namespace_pool_startup_script": startup,
+        "namespace_action_isolation": "none",
+    }
+
+def namespace_executor_config(cache_enabled, cache_uploads):
+    return CommandExecutorConfig(
+        local_enabled = True,
+        remote_enabled = namespace_re_enabled(),
+        remote_execution_properties = namespace_re_properties(),
+        remote_execution_use_case = "buck2-default",
+        remote_output_paths = "output_paths",
+        remote_cache_enabled = cache_enabled,
+        allow_cache_uploads = cache_uploads,
+        use_windows_path_separators = False,
+    )
+
