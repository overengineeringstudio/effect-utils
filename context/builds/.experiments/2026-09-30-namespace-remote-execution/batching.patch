diff --git a/buck2/dependencies/fused-extract-entry.ts b/buck2/dependencies/fused-extract-entry.ts
new file mode 100644
--- /dev/null
+++ b/buck2/dependencies/fused-extract-entry.ts
@@ -0,0 +1,10 @@
+// Disposable prototype: does removing one extract/entry scheduling boundary help cold //:quick?
+const args = process.argv.slice(2)
+const boundary = args.indexOf('--assemble')
+if (args[0] !== '--extract' || boundary < 2)
+  throw new Error('expected --extract COMMAND --assemble COMMAND')
+for (const command of [args.slice(1, boundary), args.slice(boundary + 1)]) {
+  const child = Bun.spawn(command, { stdin: 'ignore', stdout: 'inherit', stderr: 'inherit' })
+  const status = await child.exited
+  if (status !== 0) process.exit(status)
+}
