load("@prelude//rust:cargo_package.bzl", "DEFAULT_REINDEER_PLATFORMS", "set_reindeer_platforms")

# wasm products keep their native action executor; Cargo target predicates follow
# the compilation-target constraint rather than the preserved executor OS/CPU.
set_reindeer_platforms(select({
    "//buck2/rust:wasm32_config": "wasm32",
    "DEFAULT": DEFAULT_REINDEER_PLATFORMS,
}))
