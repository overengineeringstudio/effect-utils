# Demo runtime state — regenerated by reset.sh, never committed.
*.sqlite
*.sqlite-shm
*.sqlite-wal
.notion-md/
*.conflict.roughdraft.md
.demo-state/

# E2E harness evidence (raw per-demo runs + served copies) — generated, never committed.
explainers/*-evidence/
*/evidence/
harness/.auth/

# demo-env provisioned environments (manifests + local replicas, never committed).
.demo-envs/

# control dashboard rebuild (Vite/React/Tailwind app) — WIP artifacts, never committed.
# The bun-managed app is standalone (own node_modules, outside the pnpm workspace);
# bun.lock IS tracked. The built HTML + generated model + deps are regenerated.
dashboard/app/node_modules/
dashboard/app/dist/
dashboard/app/src/model.gen.ts
explainers/control.next.html

# explainers SSG rebuild (standalone bun app, own node_modules; bun.lock IS tracked).
# The kit is shared source consumed by the SSG; node_modules is symlinked into it.
dashboard/explainers/node_modules/
dashboard/explainers/dist/
dashboard/kit/node_modules
explainers/notion-*.next.html
