def _run(ctx):
    nodes = ctx.aquery().eval('attrfilter(category, "rustc", all_actions(deps(set("//rust/effect-rust-fixtures/napi-adapter:napi" "//rust/effect-rust-fixtures/wasm-adapter:wasm"))))')
    selected = []
    observed = []
    for node in nodes:
        action = node.action()
        if len(observed) < 3:
            observed.append((str(action.owner()), str(node.attrs.identifier)))
        if SELECTED.get(str(action.owner())) == str(node.attrs.identifier):
            selected.append(action)
    if len(selected) != 89:
        fail("expected 89 native rustc actions, got", len(selected), "first owners:", observed)
    for action in selected:
        for artifact in action.outputs():
            ctx.output.print(ctx.output.ensure(artifact))

run = bxl_main(impl = _run, cli_args = {})
