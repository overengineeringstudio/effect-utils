load("//buck2:static_checks.bzl", _quick_contract_source_set = "static_source_set")
load(":probe.bzl", "ts_sandbox_probe")

# Linux containment receipt (the default output is JSON):
#   buck2 build effect_utils//buck2/tests/ts_sandbox:probe --show-output
# This intentionally has no Darwin unsandboxed counterpart: macOS remains an
# unsupported containment lane, not a failing required native execution lane.
ts_sandbox_probe(
    name = "probe",
    probe = "probe.ts",
    visibility = ["PUBLIC"],
)

ts_sandbox_probe(
    name = "bash-probe",
    probe = "probe.sh",
    non_ts = True,
    visibility = ["PUBLIC"],
)

_quick_contract_source_set(
    name = "quick_contract_sources",
    prefix = "buck2/tests/ts_sandbox",
    srcs = [
    "BUCK",
    "probe.bzl",
    "probe.sh",
    "probe.ts"
],
    visibility = ["PUBLIC"],
)
