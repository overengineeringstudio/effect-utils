# TypeScript vertical-slice toolchain. Bun and effect-tsgo are exact executable
# paths from this repository's pinned Nix inputs. The selected pair is immutable
# and identical across worktrees on the same host platform, so both commands are
# represented in the action-key identity (EXEC-R02).
effect_tsgo_toolchain(
    name = "effect_tsgo",
    bun_by_platform = _BUN_BY_PLATFORM,
    executable_by_platform = _TSGO_BY_PLATFORM,
    runner = "//:packages/@overeng/buck2-tools/src/typescript-runner.ts",
    visibility = ["PUBLIC"],
)

# Analysis-only fixture: the rule and platform live in the hub cell and must
# consume the exact same ProductPlatformInfo identity.
