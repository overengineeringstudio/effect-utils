# Package boundaries and hidden-directory anchors are owned by Genie. Regenerate
# owning BUCK files for new packages or deeper hidden-directory chains; Buck has
# no include_dotfiles switch. Existing anchored directories retain live globs.
_quick_contract_source_excludes = [
    anchor + ancestor + directory + "/" + tail
    for anchor in [""]
    for ancestor in ["", "**/", "**/.*/**/", "**/.*/**/.*/**/"]
    for directory in [".buck2",".cache",".codex",".context",".devenv",".direnv",".editor-view",".evergreen",".git",".playwright-cli",".playwright-mcp",".pnpm",".pnpm-home",".pnpm-store",".vercel",".vitest-attachments",".worktree-tools","buck-out","dist","genie-locks","node_modules","repos","result","storybook-static","target","tmp"]
    for tail in ["**/*","**/.*","**/.*/**/*","**/.*/**/.*","**/.*/**/.*/**/*"]
] + [
    anchor + tail[:-1] + temporary
    for anchor in [""]
    for tail in ["**/*","**/.*","**/.*/**/*","**/.*/**/.*","**/.*/**/.*/**/*"]
    for temporary in [".BUCK.next.*", ".git-archives.json.next.*"]
]

