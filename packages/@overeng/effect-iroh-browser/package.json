{
  "$genie": {
    "source": "package.json.genie.ts",
    "warning": "DO NOT EDIT - changes will be overwritten",
    "workspaceClosureDirs": [
      "packages/@overeng/effect-iroh-browser"
    ]
  },
  "name": "@overeng/effect-iroh-browser",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/src/mod.d.ts",
      "default": "./src/mod.ts"
    },
    "./download": {
      "types": "./dist/src/download.d.ts",
      "default": "./src/download.ts"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "default": "./src/testing.ts"
    },
    "./wasm": {
      "types": "./wasm/games_iroh_wasm.d.ts",
      "default": "./wasm/games_iroh_wasm.js"
    },
    "./wasm/iroh.wasm": "./wasm/games_iroh_wasm_bg.wasm"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.0",
    "@types/node": "26.5.0",
    "effect": "4.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/mod.d.ts",
        "default": "./dist/src/mod.js"
      },
      "./testing": {
        "types": "./dist/src/testing.d.ts",
        "default": "./dist/src/testing.js"
      },
      "./download": {
        "types": "./dist/src/download.d.ts",
        "default": "./dist/src/download.js"
      },
      "./wasm": {
        "types": "./wasm/games_iroh_wasm.d.ts",
        "default": "./wasm/games_iroh_wasm.js"
      },
      "./wasm/iroh.wasm": "./wasm/games_iroh_wasm_bg.wasm"
    }
  }
}
