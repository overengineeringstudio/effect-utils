{
  "$genie": {
    "source": "package.json.genie.ts",
    "warning": "DO NOT EDIT - changes will be overwritten",
    "workspaceClosureDirs": [
      "packages/@overeng/npm-release",
      "packages/@overeng/utils-dev"
    ]
  },
  "name": "@overeng/npm-release",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/src/mod.d.ts",
      "default": "./src/mod.ts"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "default": "./src/cli.ts"
    }
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.3",
    "@overeng/utils-dev": "workspace:^",
    "@types/node": "26.5.0",
    "effect": "4.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@effect/platform-node": "^4.0.3",
    "effect": "^4.0.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/mod.d.ts",
        "default": "./dist/src/mod.js"
      },
      "./cli": {
        "types": "./dist/src/cli.d.ts",
        "default": "./dist/src/cli.js"
      }
    }
  }
}
