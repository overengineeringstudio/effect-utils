{
  "id": "tools.call",
  "summary": "Return tool-call IDs, names and decoded arguments without executing the tool.",
  "requirements": ["AIG-R11"],
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "auth": "bearer",
    "match": {
      "model": "fixture/tool",
      "stream": false
    },
    "body": {
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "get_weather",
            "description": "Look up the weather in a city",
            "parameters": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": ["city"],
              "additionalProperties": false
            }
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "json": {
      "id": "chatcmpl-test",
      "object": "chat.completion",
      "created": 1750000000,
      "model": "fixture/tool",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "call_1",
                "type": "function",
                "function": {
                  "name": "get_weather",
                  "arguments": "{\"city\":\"Berlin\"}"
                }
              }
            ]
          },
          "finish_reason": "tool_calls",
          "logprobs": null
        }
      ],
      "usage": {
        "prompt_tokens": 12,
        "completion_tokens": 3,
        "total_tokens": 15,
        "prompt_tokens_details": {
          "cached_tokens": 0
        }
      }
    }
  },
  "expect": {
    "outcome": "success",
    "toolCalls": [
      {
        "id": "call_1",
        "name": "get_weather",
        "arguments": {
          "city": "Berlin"
        }
      }
    ],
    "usage": {
      "input": 12,
      "output": 3,
      "total": 15,
      "cached": 0
    }
  }
}
