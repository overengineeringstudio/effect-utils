{
  "id": "structured.valid",
  "summary": "Validate structured output against the caller original schema.",
  "requirements": [
    "AIG-R05",
    "AIG-R06"
  ],
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "auth": "bearer",
    "match": {
      "model": "fixture/structured",
      "stream": false,
      "responseFormat": "json_schema"
    }
  },
  "response": {
    "status": 200,
    "json": {
      "id": "chatcmpl-test",
      "object": "chat.completion",
      "created": 1750000000,
      "model": "fixture/structured",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "{\"name\":\"Ada\",\"age\":36,\"tags\":[\"math\"]}"
          },
          "finish_reason": "stop",
          "logprobs": null
        }
      ],
      "usage": {
        "prompt_tokens": 12,
        "completion_tokens": 3,
        "total_tokens": 15,
        "prompt_tokens_details": {
          "cached_tokens": 0
        }
      }
    }
  },
  "expect": {
    "outcome": "success",
    "object": {
      "name": "Ada",
      "age": 36,
      "tags": [
        "math"
      ]
    },
    "usage": {
      "input": 12,
      "output": 3,
      "total": 15,
      "cached": 0
    }
  },
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "age": {
        "type": "number",
        "minimum": 0
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "name",
      "age",
      "tags"
    ],
    "additionalProperties": false
  }
}
