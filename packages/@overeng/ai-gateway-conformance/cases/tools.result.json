{
  "id": "tools.result",
  "summary": "Send a prior tool result and decode the continuation text.",
  "requirements": ["AIG-R11"],
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "auth": "bearer",
    "match": {
      "model": "fixture/tool",
      "stream": false,
      "hasToolResult": true
    },
    "body": {
      "messages": [
        {
          "role": "user"
        },
        {
          "role": "assistant",
          "tool_calls": [
            {
              "id": "call_1",
              "type": "function",
              "function": {
                "name": "get_weather",
                "arguments": "{\"city\":\"Berlin\"}"
              }
            }
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "call_1",
          "content": "{\"weather\":\"sunny\"}"
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "json": {
      "id": "chatcmpl-test",
      "object": "chat.completion",
      "created": 1750000000,
      "model": "fixture/tool",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "It is sunny in Berlin."
          },
          "finish_reason": "stop",
          "logprobs": null
        }
      ],
      "usage": {
        "prompt_tokens": 12,
        "completion_tokens": 3,
        "total_tokens": 15,
        "prompt_tokens_details": {
          "cached_tokens": 0
        }
      }
    }
  },
  "expect": {
    "outcome": "success",
    "text": "It is sunny in Berlin.",
    "usage": {
      "input": 12,
      "output": 3,
      "total": 15,
      "cached": 0
    }
  }
}
