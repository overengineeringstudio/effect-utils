{
  "id": "chat.text",
  "summary": "Decode ordinary chat text and supplied usage without rewriting the selected model.",
  "requirements": [
    "AIG-R01",
    "AIG-R02",
    "AIG-R03"
  ],
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "auth": "bearer",
    "match": {
      "model": "anthropic/claude-haiku-4-5",
      "stream": false
    }
  },
  "response": {
    "status": 200,
    "json": {
      "id": "chatcmpl-test",
      "object": "chat.completion",
      "created": 1750000000,
      "model": "anthropic/claude-haiku-4-5",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "Hello!"
          },
          "finish_reason": "stop",
          "logprobs": null
        }
      ],
      "usage": {
        "prompt_tokens": 12,
        "completion_tokens": 3,
        "total_tokens": 15,
        "prompt_tokens_details": {
          "cached_tokens": 0
        }
      }
    }
  },
  "expect": {
    "outcome": "success",
    "text": "Hello!",
    "usage": {
      "input": 12,
      "output": 3,
      "total": 15,
      "cached": 0
    }
  }
}
