{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MegarepoConfigEncoded",
  "$defs": {
    "VscodeGeneratorConfigEncoded": {
      "type": "object",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "exclude": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "colorEnvVar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "settings": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "GeneratorsConfigEncoded": {
      "type": "object",
      "properties": {
        "vscode": {
          "anyOf": [
            {
              "$ref": "#/$defs/VscodeGeneratorConfigEncoded"
            },
            {
              "type": "null"
            }
          ]
        },
        "composition": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "allOf": [
            {
              "description": "Retired: generators.composition was removed with the composed Buck shape; delete it from megarepo.kdl (each member is its own standalone Buck root). Ignored in nested megarepos; rejected in the root megarepo."
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "LockSyncConfigEncoded": {
      "type": "object",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "exclude": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "sharedInputSource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Megarepo.GitTransportAllowance": {
      "type": "object",
      "properties": {
        "_tag": {
          "type": "string",
          "enum": ["GitHubHttps"]
        },
        "member": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$"
        }
      },
      "required": ["_tag", "member", "reason"],
      "additionalProperties": false
    },
    "Megarepo.SourcePolicyConfig": {
      "type": "object",
      "properties": {
        "gitTransportAllowances": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Megarepo.GitTransportAllowance"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "MegarepoConfigEncoded": {
      "type": "object",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "members": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "generators": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorsConfigEncoded"
            },
            {
              "type": "null"
            }
          ]
        },
        "lockSync": {
          "anyOf": [
            {
              "$ref": "#/$defs/LockSyncConfigEncoded"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourcePolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/Megarepo.SourcePolicyConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["members"],
      "additionalProperties": false
    }
  }
}
