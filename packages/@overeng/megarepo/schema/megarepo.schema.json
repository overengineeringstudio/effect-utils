{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MegarepoConfigEncoded",
  "$defs": {
    "VscodeGeneratorConfigEncoded": {
      "type": "object",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "exclude": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "colorEnvVar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "settings": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "GeneratorsConfigEncoded": {
      "type": "object",
      "properties": {
        "vscode": {
          "anyOf": [
            {
              "$ref": "#/$defs/VscodeGeneratorConfigEncoded"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "LockSyncConfigEncoded": {
      "type": "object",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "exclude": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "sharedInputSource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "MegarepoConfigEncoded": {
      "type": "object",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "members": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "generators": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorsConfigEncoded"
            },
            {
              "type": "null"
            }
          ]
        },
        "lockSync": {
          "anyOf": [
            {
              "$ref": "#/$defs/LockSyncConfigEncoded"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["members"],
      "additionalProperties": false
    }
  }
}
