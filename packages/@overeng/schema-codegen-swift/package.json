{
  "$genie": {
    "source": "package.json.genie.ts",
    "warning": "DO NOT EDIT - changes will be overwritten",
    "workspaceClosureDirs": [
      "packages/@overeng/content-address",
      "packages/@overeng/effect-distributed-lock",
      "packages/@overeng/effect-rust",
      "packages/@overeng/genie",
      "packages/@overeng/otel-contract",
      "packages/@overeng/schema-codegen",
      "packages/@overeng/schema-codegen-swift",
      "packages/@overeng/tui-core",
      "packages/@overeng/tui-react",
      "packages/@overeng/utils",
      "packages/@overeng/utils-dev",
      "packages/@overeng/utils-storybook"
    ]
  },
  "name": "@overeng/schema-codegen-swift",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/src/mod.d.ts",
      "default": "./src/mod.ts"
    },
    "./genie": {
      "types": "./dist/src/genie.d.ts",
      "default": "./src/genie.ts"
    }
  },
  "dependencies": {
    "@overeng/genie": "workspace:^",
    "@overeng/schema-codegen": "workspace:^",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@types/node": "26.5.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/mod.d.ts",
        "default": "./dist/src/mod.js"
      },
      "./genie": {
        "types": "./dist/src/genie.d.ts",
        "default": "./dist/src/genie.js"
      }
    }
  }
}
