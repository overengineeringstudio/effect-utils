{
  "$genie": {
    "source": "package.json.genie.ts",
    "warning": "DO NOT EDIT - changes will be overwritten",
    "workspaceClosureDirs": [
      "packages/@overeng/content-address",
      "packages/@overeng/effect-distributed-lock",
      "packages/@overeng/effect-rpc-explorer",
      "packages/@overeng/effect-rpc-explorer-react",
      "packages/@overeng/otel-contract",
      "packages/@overeng/stylex-tokens",
      "packages/@overeng/utils",
      "packages/@overeng/utils-dev"
    ]
  },
  "name": "@overeng/effect-rpc-explorer-react",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Dense, policy-safe React explorer for @overeng/effect-rpc-explorer",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./src/mod.ts"
    },
    "./styles.css": "./src/styles.css",
    "./themes": {
      "types": "./dist/themes.d.ts",
      "default": "./src/themes.ts"
    },
    "./tokens.stylex": {
      "types": "./dist/tokens.stylex.d.ts",
      "default": "./src/tokens.stylex.ts"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.json && vite build",
    "storybook": "storybook dev -p 6017",
    "storybook:build": "storybook build",
    "gate": "bun node_modules/@overeng/utils/src/node/storybook/gate/cli.ts"
  },
  "dependencies": {
    "@overeng/effect-rpc-explorer": "workspace:^",
    "@overeng/stylex-tokens": "workspace:^",
    "@stylexjs/stylex": "0.19.0"
  },
  "devDependencies": {
    "@overeng/utils": "workspace:^",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "effect": "4.0.0-rc.113",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.113",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/mod.js",
      "./styles.css": "./dist/styles.css",
      "./tokens.stylex": "./dist/tokens.stylex.js",
      "./themes": "./dist/themes.js"
    }
  }
}
