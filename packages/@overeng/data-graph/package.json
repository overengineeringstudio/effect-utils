{
  "$genie": {
    "source": "package.json.genie.ts",
    "warning": "DO NOT EDIT - changes will be overwritten",
    "workspaceClosureDirs": [
      "packages/@overeng/content-address",
      "packages/@overeng/data-graph",
      "packages/@overeng/effect-rust",
      "packages/@overeng/utils-dev"
    ]
  },
  "name": "@overeng/data-graph",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/src/mod.d.ts",
      "default": "./src/mod.ts"
    }
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "@overeng/content-address": "workspace:^",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@overeng/utils-dev": "workspace:^",
    "@types/node": "26.5.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/mod.d.ts",
        "default": "./dist/src/mod.js"
      }
    }
  }
}
