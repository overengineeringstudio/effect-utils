{
  "$genie": {
    "source": "package.json.genie.ts",
    "warning": "DO NOT EDIT - changes will be overwritten",
    "workspaceClosureDirs": [
      "packages/@overeng/scg-authority",
      "packages/@overeng/scg-discord",
      "packages/@overeng/scg-protocol"
    ]
  },
  "name": "@overeng/scg-discord",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/src/mod.d.ts",
      "default": "./src/mod.ts"
    },
    "./card": {
      "types": "./dist/src/card.d.ts",
      "default": "./src/card.ts"
    }
  },
  "dependencies": {
    "@overeng/scg-protocol": "workspace:^",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.0",
    "@effect/vitest": "4.1.0",
    "@overeng/scg-authority": "workspace:^",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
